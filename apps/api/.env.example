# Referencia para variables de entorno; Spring no carga este archivo automáticamente.
# scripts/backend.ps1 lee .local/backend.json para desarrollo Windows.
DB_URL=jdbc:postgresql://127.0.0.1:55432/modela
DB_USERNAME=modela
DB_PASSWORD=CONFIGURAR_LOCALMENTE
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CONFIGURAR_UNA_CONTRASENA_ALEATORIA
GOOGLE_CLIENT_ID=
SERVER_ADDRESS=127.0.0.1
PORT=8080
COOKIE_SECURE=false
