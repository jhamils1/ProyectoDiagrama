# Solo para Docker local. Copia este archivo como docker/.env antes de iniciar.
# Para AWS se usarán valores nuevos y secretos almacenados fuera del repositorio.
POSTGRES_DB=modela
POSTGRES_USER=modela
POSTGRES_PASSWORD=cambia_esta_clave_local
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=cambia_esta_clave_local
GOOGLE_CLIENT_ID=
API_PORT=8080
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=